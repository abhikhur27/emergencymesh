# Private values belong in .env or the process environment, never committed.
RESCUEMESH_SUPERVISOR_DATA=.supervisor
RESCUEMESH_SUPERVISOR_PORT=4782
# RESCUEMESH_SUPERVISOR_PUBLIC_ORIGIN=https://your-private-supervisor.example
# MONGODB_URI=mongodb://username:password@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=rescuemesh_supervisor
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron-3-nano:4b
RESCUEMESH_MODEL_TIMEOUT_MS=20000
# Cold model warm-up / synthetic native-tool verification only:
RESCUEMESH_MODEL_CHECK_TIMEOUT_MS=150000
