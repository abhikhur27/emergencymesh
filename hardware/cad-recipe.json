  {
    "name": "execute_code",
    "arguments": {
      "code": "import Part, Mesh, json\ndoc = FreeCAD.getDocument('RescueMeshEnclosure')\nfor item in doc.Objects: item.ViewObject.Visibility = item.Name in ['BasePrint', 'LidPrint', 'AdapterPrint']\ndoc.getObject('BasePrint').ViewObject.ShapeColor=(0.10,0.13,0.16)\ndoc.getObject('LidPrint').ViewObject.ShapeColor=(0.96,0.34,0.17)\ndoc.getObject('AdapterPrint').ViewObject.ShapeColor=(0.10,0.13,0.16)\ndoc.recompute()\ndoc.saveAs('C:/Users/abhim/Documents/ChatGPT/hackutd/emergency-mesh/hardware/RescueMesh-enclosure.FCStd')\nPart.export([doc.getObject('BasePrint'),doc.getObject('LidPrint'),doc.getObject('AdapterPrint')], 'C:/Users/abhim/Documents/ChatGPT/hackutd/emergency-mesh/hardware/RescueMesh-enclosure.step')\nfor name in ['BasePrint','LidPrint','AdapterPrint']:\n    Mesh.export([doc.getObject(name)], 'C:/Users/abhim/Documents/ChatGPT/hackutd/emergency-mesh/hardware/' + name + '.stl')\n    s=doc.getObject(name).Shape\n    print(json.dumps({'object':name,'valid':s.isValid(),'solids':len(s.Solids),'volume_mm3':s.Volume,'bounds_mm':[s.BoundBox.XLength,s.BoundBox.YLength,s.BoundBox.ZLength]}))\nGui.activeDocument().activeView().viewAxonometric()\nGui.activeDocument().activeView().fitAll()",
      "include_screenshot": false,
      "timeout": 180
    }
